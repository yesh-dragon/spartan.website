{
  "name": "@agent-guard/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/migrate.ts --seed-only",
    "db:verify": "tsx src/scripts/migrate.ts --verify-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-guard/core": "*",
    "@agent-guard/shared": "*",
    "@google/genai": "3.3.0",
    "@supabase/supabase-js": "2.119.0",
    "cors": "2.8.6",
    "dotenv": "16.5.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "pg": "^8.16.3",
    "pino": "10.4.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.15.29",
    "@types/pg": "^8.15.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}
